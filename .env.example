# ── Jabber — Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All VITE_ vars are baked into the bundle at build time by Vite.
# After editing .env, restart `npm run dev` or redeploy.

# ── PostHog Analytics ──────────────────────────────────────────────────────────
# Privacy-first product analytics (free: 1M events/month, no cookie banner needed)
# 1. Sign up at https://app.posthog.com
# 2. Create a project
# 3. Copy the Project API Key (starts with phc_)
VITE_POSTHOG_KEY=phc_YOUR_KEY_HERE

# ── Supabase PostgreSQL ────────────────────────────────────────────────────────
# Required for real lead/signup/ticket storage across devices.
# Without this, the app runs in Demo mode (localStorage + seed data).
#
# Setup:
# 1. Create a free project at https://supabase.com
# 2. Open the SQL Editor and run the contents of:
#    supabase/migrations/20260529000000_init.sql
# 3. Go to Project Settings → API and copy:
#    - Project URL  → VITE_SUPABASE_URL
#    - anon/public key → VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
