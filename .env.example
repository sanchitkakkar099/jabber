# PostHog Analytics
# 1. Sign up at https://app.posthog.com (free — 1M events/month)
# 2. Create a project, copy the Project API Key (starts with phc_)
VITE_POSTHOG_KEY=phc_YOUR_KEY_HERE

# Supabase PostgreSQL (required for real lead/signup/ticket storage)
# 1. Create a free project at https://supabase.com
# 2. Run the schema SQL from the README in the Supabase SQL Editor
# 3. Go to Project Settings → API → copy Project URL and anon/public key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
